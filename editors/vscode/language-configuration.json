{
  "comments": { "lineComment": "//" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""]],
  "colorizedBracketPairs": [["(", ")"], ["[", "]"]],
  "indentationRules": {
    "increaseIndentPattern": "[(\\[]\\s*$",
    "decreaseIndentPattern": "^\\s*[)\\]]"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*"
}
